{
  "name": "chi-toolbox",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/build-server.mjs",
    "start": "node scripts/start-server.mjs",
    "lint": "oxlint",
    "format": "oxfmt app features shared shell styles scripts tests",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/unit/*.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm run typecheck && npm run lint && npm test",
    "test:smoke": "node scripts/smoke-server.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "build:test": "node scripts/build-test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
